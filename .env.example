# ─────────────────────────────────────────────────────────────────────────────
# Interview Scheduler frontend — environment variables (Vite)
#
# VITE_* values are baked into the JavaScript bundle at build time and are public:
# never put secrets here. After changing them on Vercel, redeploy the frontend.
# REQUIRED = a production build fails without it.
# ─────────────────────────────────────────────────────────────────────────────

# REQUIRED: backend base URL ("/api" is appended automatically if missing)
VITE_API_BASE_URL=https://your-backend-host/api

# REQUIRED: Google OAuth client ID — must equal the backend's GOOGLE_CLIENT_ID.
# Add the frontend origin under "Authorized JavaScript origins" on the OAuth client.
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Optional: visible hour range of the calendar views (defaults 7 and 19)
VITE_CALENDAR_MIN_HOUR=6
VITE_CALENDAR_MAX_HOUR=18
